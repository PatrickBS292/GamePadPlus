<Window x:Class="GamePadPlus.CreateGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Game"
        Height="420"
        Width="650"
        Background="#1E2329"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <Style x:Key="CreateButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Background" Value="#303740"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A414A"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#FF8A3D"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#FF8A3D"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderThickness"
                                    Value="2"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <StackPanel
            Width="350"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">


           

            <TextBlock
                Text="Create New Game"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#FF8A3D"
                HorizontalAlignment="Center"
                Margin="0,0,0,30"/>


       

            <TextBlock
                Text="Game name"
                FontSize="14"
                Foreground="#AEB4BA"
                Margin="0,0,0,8"/>


          

            <TextBox
                x:Name="GameNameBox"
                Height="42"
                Padding="10"
                Background="#303740"
                Foreground="#E8E8E8"
                BorderBrush="#3A414A"
                BorderThickness="1"
                FontSize="15"
                CaretBrush="#FF8A3D"
                KeyDown="GameNameBox_KeyDown"/>


            

            <Button
                Content="Create"
                Style="{StaticResource CreateButtonStyle}"
                HorizontalAlignment="Center"
                Margin="0,25,0,0"
                Click="CreateGame_Click"
                Foreground="#FF8A3D"/>

        </StackPanel>

    </Grid>

</Window>