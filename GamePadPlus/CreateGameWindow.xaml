<Window x:Class="GamePadPlus.CreateGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GamePadPlus"
        mc:Ignorable="d"
        Title="Create New Game" Height="450" Width="800">
    <Grid>
        <StackPanel
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

            <TextBlock
        Text="Create New Game"
        FontSize="30"
        HorizontalAlignment="Center"
        Margin="0,0,0,20"/>


            <TextBox
        x:Name="GameNameBox"
        Width="250"
        Height="35"
        KeyDown="GameNameBox_KeyDown"/>


			<Button
        Content="Create"
        Width="120"
        Height="35"
        Margin="0,20,0,0"
		Click="CreateGame_Click"/>

        </StackPanel>
    </Grid>
</Window>
