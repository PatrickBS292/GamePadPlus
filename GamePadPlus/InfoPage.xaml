<Page x:Class="GamePadPlus.InfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Info">

    <StackPanel Margin="40">

        <TextBlock
            Text="About GamePad+"
            FontSize="28"
            FontWeight="Bold"
            Margin="0,0,0,20"
            Foreground="#FF8A3D"/>
            

        <TextBlock
            Text="GamePad+ is a personal game library where you can keep track of your games and write notes about them."
            FontSize="16"
            TextWrapping="Wrap"
            Foreground="#FF8A3D"/>

    </StackPanel>

</Page>