<Page x:Class="GamePadPlus.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:GamePadPlus"
      xmlns:services="clr-namespace:GamePadPlus.Services"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Library"
      Background="#1E2329">

    <Page.Resources>

        <services:CoverImageConverter
            x:Key="CoverImageConverter"/>

    </Page.Resources>

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid
            Grid.Row="0"
            Margin="30,25,30,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock
                Text="Game Library"
                FontSize="32"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Foreground="#FF8A3D"/>
            
            <Button
                Grid.Column="1"
                Content="+ Add Game"
                Width="140"
                Height="42"
                Click="AddGame_Click"
                Background="#303740"
                Foreground="#FF8A3D"
                BorderThickness="0"
                FontSize="15"
                FontWeight="SemiBold"
                Cursor="Hand">

                <Button.Template>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>


                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#FF8A3D"/>
                            </Trigger>


                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#FF8A3D"/>
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderThickness"
                                    Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Margin="15,5,20,20"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl x:Name="GameList">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>


                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Grid
                            Width="220"
                            Height="280"
                            Margin="15">

                            <Button
                                Click="GameCard_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border
                                            x:Name="CardBorder"
                                            CornerRadius="12"
                                            BorderBrush="#3A414A"
                                            BorderThickness="1"
                                            Background="#252B32">

                                            <StackPanel>



                                                <Border
                                                    Width="200"
                                                    Height="180"
                                                    Margin="10"
                                                    Background="#303740"
                                                    CornerRadius="8">

                                                    <Image
                                                        Source="{Binding ImageFileName, Converter={StaticResource CoverImageConverter}}"
                                                        Stretch="UniformToFill"/>

                                                </Border>




                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Foreground="#FF8A3D"
                                                    HorizontalAlignment="Center"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap"
                                                    MaxHeight="50"
                                                    Margin="10,5"/>

                                            </StackPanel>

                                        </Border>


                                        <ControlTemplate.Triggers>



                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter
                                                    TargetName="CardBorder"
                                                    Property="BorderBrush"
                                                    Value="#FF8A3D"/>

                                            </Trigger>




                                            <Trigger Property="IsPressed" Value="True">

                                                <Setter
                                                    TargetName="CardBorder"
                                                    Property="BorderBrush"
                                                    Value="#FF8A3D"/>

                                                <Setter
                                                    TargetName="CardBorder"
                                                    Property="BorderThickness"
                                                    Value="2"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                            <Button
                                Content="×"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,8,8"
                                Click="DeleteGame_Click"
                                Background="#303740"
                                Foreground="#E8E8E8"
                                BorderBrush="#FF8A3D"
                                BorderThickness="1"
                                FontSize="17"
                                FontWeight="Bold"
                                Panel.ZIndex="1"
                                Cursor="Hand">  

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7">

                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>    

                                        </Border>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                        </Grid>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Page>