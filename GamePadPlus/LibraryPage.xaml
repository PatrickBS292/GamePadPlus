<Page x:Class="GamePadPlus.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:GamePadPlus"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Library">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Text="GamePad+"
                FontSize="40"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Foreground="Black"/>

            <Button 
                Grid.Column="1"
                FontSize="40"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Foreground="Black"/>

            <Button
                Grid.Column="1"
                Content="+ Add Game"
                Width="150"
                Height="40"
                Click="AddGame_Click"/>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Margin="20"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <ItemsControl x:Name="GameList">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Grid
            Width="220"
            Height="280"
            Margin="15">

                           
                            <Button
                Click="GameCard_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">

                                <Border
                    CornerRadius="12"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    Background="#2D2D30">

                                    <StackPanel>

                                        <Border
                            Width="200"
                            Height="180"
                            Margin="10"
                            Background="#404040"
                            CornerRadius="8">

                                            <TextBlock
                                Text="No Cover"
                                Foreground="LightGray"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxHeight="50"
                            Margin="10,5"/>

                                    </StackPanel>

                                </Border>

                            </Button>

                            
                            <Button
                Content="×"
                Width="30"
                Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,5,5,0"
                Click="DeleteGame_Click"
                Background="#3A3A3A"
                Foreground="White"
                BorderThickness="0"
                FontSize="18"
                FontWeight="Bold"
                Panel.ZIndex="1"/>

                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Page>